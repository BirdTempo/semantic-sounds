{
  "name": "semantic-sounds",
  "version": "0.1.0",
  "description": "A curated set of short UI sounds, found by plain prose.",
  "type": "module",
  "license": "MIT",
  "author": "BirdTempo",
  "repository": {
    "type": "git",
    "url": "https://github.com/birdtempo/semantic-sounds.git"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/library/index.ts --format esm --dts --clean --out-dir dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sounds:build": "tsx scripts/build-library.ts",
    "sounds:check": "tsx scripts/check-library.ts",
    "probe": "tsx scripts/prose-probe.ts",
    "tune": "tsx scripts/tune-thresholds.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "review": "tsx scripts/review/main.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@types/node": "^26.5.1",
    "esbuild": "^0.25.12",
    "tsup": "^8.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0",
    "zod": "^3.25.76"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "esbuild@0.21.5": true
  }
}
